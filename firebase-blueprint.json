{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Registered user profile details",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "Manager": {
      "title": "Channel Manager",
      "description": "Details about CryptoPrime managers",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "bio": { "type": "string" },
        "telegram": { "type": "string" },
        "avatarUrl": { "type": "string" }
      },
      "required": ["name", "role", "telegram"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Collection of user profiles indexed by their Firebase Auth UID"
    },
    "managers/{managerId}": {
      "schema": "Manager",
      "description": "Publicly readable info about channel managers"
    }
  }
}
