rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User validation
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'displayName', 'role'])
        && data.keys().size() == 5
        && data.uid is string && data.uid == request.auth.uid
        && data.email is string && data.email == request.auth.token.email
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['user', 'admin']
        && data.createdAt == request.time;
    }

    // Manager validation
    function isValidManager(data) {
      return data.keys().hasAll(['name', 'role', 'telegram', 'bio', 'avatarUrl'])
        && data.keys().size() == 5
        && data.name is string && data.name.size() <= 100
        && data.role is string && data.role.size() <= 100
        && data.telegram is string && data.telegram.size() <= 100
        && data.bio is string && data.bio.size() <= 500
        && data.avatarUrl is string && data.avatarUrl.size() <= 500;
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) 
        && isValidUser(incoming())
        && incoming().role == 'user'; // Users cannot self-promote to admin on create
      
      allow update: if isOwner(userId)
        && isValidUser(incoming())
        && (
          // Action: Profile Update
          (incoming().diff(existing()).affectedKeys().hasOnly(['displayName']))
        )
        && incoming().role == existing().role; // Cannot change role

      allow delete: if isAdmin();
    }

    // Managers collection
    match /managers/{managerId} {
      allow read: if true; // Publicly readable for the presentation
      allow create, update, delete: if isAdmin() && isValidManager(incoming());
    }

    // Admins collection (internal record)
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed via Firebase Console or special script
    }
  }
}
